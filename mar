from kivy.app import App
from kivy.uix.widget import Widget
from kivy.clock import Clock
from kivy.graphics import Rectangle, Color
from kivy.core.window import Window
from random import randint

class SnakeGame(Widget):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        Window.size = (800, 600)
        self.snake_size = 20
        self.snake = [(400, 300)]  # شروع مار در وسط صفحه
        self.snake_dir = (0, 0)  # جهت حرکت (x,y)
        self.food = self.spawn_food()
        self.score = 0

        Clock.schedule_interval(self.update, 0.1)
        self._keyboard = Window.request_keyboard(self._keyboard_closed, self)
        self._keyboard.bind(on_key_down=self.on_key_down)

    def spawn_food(self):
        x = randint(0, (Window.width - self.snake_size) // self.snake_size) * self.snake_size
        y = randint(0, (Window.height - self.snake_size) // self.snake_size) * self.snake_size
        return (x, y)

    def on_key_down(self, keyboard, keycode, text, modifiers):
        key = keycode[1]
        x_dir, y_dir = self.snake_dir

        if key == 'left' and x_dir == 0:
            self.snake_dir = (-self.snake_size, 0)
        elif key == 'right' and x_dir == 0:
            self.snake_dir = (self.snake_size, 0)
        elif key == 'up' and y_dir == 0:
            self.snake_dir = (0, self.snake_size)
        elif key == 'down' and y_dir == 0:
            self.snake_dir = (0, -self.snake_size)
        return True

    def update(self, dt):
        if self.snake_dir == (0, 0):
            return

        # حرکت مار
        head_x, head_y = self.snake[-1]
        dir_x, dir_y = self.snake_dir
        new_head = (head_x + dir_x, head_y + dir_y)

        # چک کردن برخورد با دیوار
        if (new_head[0] < 0 or new_head[0] >= Window.width or
            new_head[1] < 0 or new_head[1] >= Window.height or
            new_head in self.snake):
            self.game_over()
            return

        self.snake.append(new_head)

        # اگر غذا خورده شده، امتیاز بگیر و غذا رو عوض کن، در غیر اینصورت دم مار رو حذف کن
        if new_head == self.food:
            self.score += 1
            self.food = self.spawn_food()
        else:
            self.snake.pop(0)

        self.draw()

    def draw(self):
        self.canvas.clear()
        with self.canvas:
            # بک‌گراند سفید
            Color(1, 1, 1)
            Rectangle(pos=(0, 0), size=Window.size)

            # رسم غذا قرمز
            Color(1, 0, 0)
            Rectangle(pos=self.food, size=(self.snake_size, self.snake_size))

            # رسم مار مشکی
            Color(0, 0, 0)
            for segment in self.snake:
                Rectangle(pos=segment, size=(self.snake_size, self.snake_size))

    def game_over(self):
        self.snake_dir = (0, 0)
        print(f"Game Over! Your score: {self.score}")
        # می‌تونی اینجا پیام گرافیکی بذاری یا دکمه ریست بزنی

class SnakeApp(App):
    def build(self):
        return SnakeGame()

if __name__ == '__main__':
    SnakeApp().run()
